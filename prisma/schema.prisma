generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  super_admin
  publik
  admin
  pegawai
  kepala_balai
}

enum StatusAkun {
  active
  inactive
}

enum StatusTiket {
  diajukan
  menunggu_verifikasi
  menunggu_persetujuan_kepala_balai
  perlu_revisi
  menunggu_ebilling
  menunggu_pembayaran
  diproses
  dipinjam
  diterima
  menunggu_konfirmasi
  selesai
  ditolak
  dibatalkan
}

enum StatusBayar {
  menunggu
  lunas
  batal
}

enum KanalNotifikasi {
  dashboard
  email
}

model User {
  id             Int         @id @default(autoincrement())
  email          String?     @unique
  password       String
  initial_password String?
  nama           String
  nip            String?     @unique
  username       String?     @unique
  no_hp          String?
  role           Role        @default(publik)
  status_akun    StatusAkun  @default(active)
  unit_teknis_id Int?
  unit_teknis    UnitTeknis? @relation(fields: [unit_teknis_id], references: [id])
  instansi       String?
  alamat         String?     @db.Text
  email_verified             Boolean   @default(false)
  verification_token         String?   @unique
  verification_token_expires DateTime?
  reset_token                String?   @unique
  reset_token_expires        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tikets            Tiket[]
  notifikasis       Notifikasi[]
  auditLogs         AuditLog[]
  passwordHistories PasswordHistory[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model PasswordHistory {
  id        Int      @id @default(autoincrement())
  user_id   Int
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  password  String
  createdAt DateTime @default(now())

  @@map("password_history")
}

model UnitTeknis {
  id        Int       @id @default(autoincrement())
  nama      String
  users     User[]
  tikets    Tiket[]
  layanan   Layanan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("unit_teknis")
}

model Layanan {
  id             Int         @id @default(autoincrement())
  nama_layanan   String      @unique
  slug           String      @unique
  biaya          Json
  sla_hari       Int?
  form_schema    Json
  is_active      Boolean     @default(true)
  unit_teknis_id Int?
  unit_teknis    UnitTeknis? @relation(fields: [unit_teknis_id], references: [id])
  tikets         Tiket[]
  pengaduans     Pengaduan[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("layanan")
}

model Tiket {
  id             Int         @id @default(autoincrement())
  no_tiket       String      @unique
  user_id        Int
  user           User        @relation(fields: [user_id], references: [id])
  layanan_id     Int
  layanan        Layanan     @relation(fields: [layanan_id], references: [id])
  jawaban_form   Json?
  status         StatusTiket @default(diajukan)
  tanggal_submit DateTime    @default(now())
  tanggal_sla    DateTime?
  unit_teknis_id Int?
  unit_teknis    UnitTeknis? @relation(fields: [unit_teknis_id], references: [id])

  dokumen    Dokumen[]
  tagihan    Tagihan?
  notifikasi Notifikasi[]
  auditLog   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([unit_teknis_id, status])
  @@map("tiket")
}

model Dokumen {
  id             Int      @id @default(autoincrement())
  tiket_id       Int
  tiket          Tiket    @relation(fields: [tiket_id], references: [id])
  nama_file      String
  tipe           String
  url_storage    String
  tanggal_upload DateTime @default(now())

  @@map("dokumen")
}

model Tagihan {
  id               Int         @id @default(autoincrement())
  tiket_id         Int         @unique
  tiket            Tiket       @relation(fields: [tiket_id], references: [id])
  jumlah           Int
  kode_ebilling    String?
  ntpn             String?
  status_bayar     StatusBayar @default(menunggu)
  bukti_bayar      String?
  tanggal_lunas    DateTime?
  bank_pengirim    String?
  nama_pengirim    String?
  tanggal_transfer DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tagihan")
}

model Notifikasi {
  id           Int             @id @default(autoincrement())
  user_id      Int
  user         User            @relation(fields: [user_id], references: [id])
  tiket_id     Int?
  tiket        Tiket?          @relation(fields: [tiket_id], references: [id])
  kanal        KanalNotifikasi @default(dashboard)
  judul        String?
  pesan        String          @db.Text
  dibaca       Boolean         @default(false)
  status_kirim Boolean         @default(false)
  timestamp    DateTime        @default(now())

  @@map("notifikasi")
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  user_id          Int?
  user             User?    @relation(fields: [user_id], references: [id])
  tiket_id         Int?
  tiket            Tiket?   @relation(fields: [tiket_id], references: [id])
  aksi             String
  detail_perubahan String?  @db.Text
  timestamp        DateTime @default(now())

  @@map("audit_log")
}

model Pengaduan {
  id               Int      @id @default(autoincrement())
  nama_pelapor     String
  no_hp            String
  status_pelapor   String
  layanan_id       Int
  layanan          Layanan  @relation(fields: [layanan_id], references: [id])
  tanggal_kejadian DateTime
  waktu            String
  detail_kejadian  String   @db.Text
  dampak           String   @db.Text
  harapan          String   @db.Text
  bersedia_dihubungi Boolean
  bukti_pendukung  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("pengaduan")
}

model Alat {
  id               Int      @id @default(autoincrement())
  nama_alat        String
  harga_peminjaman Int
  stok             Int      @default(1)
  is_active        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("alat")
}

model Faq {
  id          Int      @id @default(autoincrement())
  pertanyaan  String   @db.Text
  jawaban     String   @db.Text
  urutan      Int      @default(0)
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faq")
}